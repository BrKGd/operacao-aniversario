rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Regra para perfil de usuários
    match /profiles/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == 'gleidson.fig@gmail.com');
    }

    // Regra para aniversariantes
    match /aniversarios/{aniversarioId} {
      allow read: if request.auth != null && (resource.data.user_id == request.auth.uid || request.auth.token.email == 'gleidson.fig@gmail.com');
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (resource.data.user_id == request.auth.uid || request.auth.token.email == 'gleidson.fig@gmail.com');
    }

    // Categorias e Templates
    match /categorias/{catId} {
      allow read, write: if request.auth != null;
    }
    
    match /mensagens_templates/{tplId} {
      allow read, write: if request.auth != null;
    }
  }
}
